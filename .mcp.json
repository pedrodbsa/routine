{
    "mcpServers": {
        "garmin": {
            "command": "uvx",
            "args": [
                "--python",
                "3.12",
                "--from",
                "git+https://github.com/Taxuspt/garmin_mcp@3610be6feed93088d85b0f35aba9d7d07c2505a7",
                "--with",
                "mcp>=1.2,<2",
                "garmin-mcp"
            ],
            "env": {
                "GARMIN_EMAIL": "${GARMIN_EMAIL}",
                "GARMIN_PASSWORD": "${GARMIN_PASSWORD}"
            }
        }
    }
}
