{
  "permissions": {
    "allow": [
      "Bash(date:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(ls:*)",
      "mcp__garmin",
      "Edit(calendar.md)",
      "Edit(logbook/**)",
      "Edit(memory/**)",
      "mcp__plugin_telegram_telegram__download_attachment",
      "mcp__plugin_telegram_telegram__edit_message",
      "mcp__plugin_telegram_telegram__react",
      "mcp__plugin_telegram_telegram__reply",
      "WebFetch(domain:believeintherun.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:marathonhandbook.com)",
      "WebFetch(domain:meta-endurance.com)",
      "WebFetch(domain:nutripedia.pt)",
      "WebFetch(domain:pmc.ncbi.nlm.nih.gov)",
      "WebFetch(domain:runnersconnect.net)",
      "WebFetch(domain:runningwritings.com)",
      "WebFetch(domain:runrepeat.com)",
      "WebFetch(domain:sport-calculator.com)",
      "WebFetch(domain:theruntesters.com)",
      "WebFetch(domain:trainright.com)",
      "WebFetch(domain:www.doctorsofrunning.com)",
      "WebFetch(domain:www.fatsecret.pt)",
      "WebFetch(domain:www.ncbi.nlm.nih.gov)",
      "WebFetch(domain:www.scienceofultra.com)",
      "WebFetch(domain:www.solereview.com)",
      "WebSearch"
    ],
    "ask": [
      "Bash(git push:*)",
      "Edit(protocols/**)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "garmin"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-protocols-bash.sh"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_telegram_telegram__(reply|edit_message)",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-telegram-format.sh"
          }
        ]
      }
    ]
  }
}
