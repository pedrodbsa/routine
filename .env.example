# Reference only. On the server these are set in Dokploy's Environment tab, which writes
# them to .env next to the compose file — this repo never carries the real values.

# Garmin Connect. Expanded into the MCP server's environment by .mcp.json.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=

# Fine-grained GitHub PAT, scoped to pedrodbsa/routine with contents:write.
GITHUB_TOKEN=

# Identity for commits made from the container.
GIT_AUTHOR_NAME=pedrodbsa
GIT_AUTHOR_EMAIL=pedrodbsa@gmail.com

TZ=Europe/Lisbon
SESSION_NAME=routine

# git-sync skips its cycle if anything changed this recently, so a commit never lands
# mid-edit.
SYNC_QUIET_MINUTES=1
