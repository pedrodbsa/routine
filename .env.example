# Reference only. On the server these are set in Dokploy's Environment tab, which writes
# them to .env next to the compose file — this repo never carries the real values.

# Garmin Connect. Expanded into the MCP server's environment by .mcp.json.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=

# Fine-grained GitHub PAT, scoped to pedrodbsa/routine with contents:write. git-sync pushes
# with it, and if the repo is private the container's first-boot clone needs it too.
GITHUB_TOKEN=

# Identity for commits made from the container.
GIT_AUTHOR_NAME=pedrodbsa
GIT_AUTHOR_EMAIL=pedrodbsa@gmail.com

TZ=Europe/Lisbon
SESSION_NAME=routine

# git-sync skips its cycle if anything changed this recently, so a commit never lands
# mid-edit.
SYNC_QUIET_MINUTES=1

# Telegram bot token from BotFather. Deliberately NOT named TELEGRAM_BOT_TOKEN: the channel
# plugin polls in every Claude process that can see that name, and only the Telegram session
# may poll. coach-telegram hands it over under the plugin's name. See docs/container.md.
COACH_TELEGRAM_BOT_TOKEN=
# Optional; defaults to the first allowlisted id from /telegram:access pair.
TELEGRAM_CHAT_ID=

# coach-tick windows, local time. The morning /plan runs once Garmin has the night's sleep
# record, and is skipped if there is neither a daily file nor a sleep record by the cutoff.
COACH_MORNING_FROM=05:00
COACH_PLAN_CUTOFF=12:00
# The evening /recap runs every day; on COACH_REPORT_DOW (1 = Monday … 7 = Sunday) the weekly
# /report follows it.
COACH_RECAP_AT=21:30
COACH_REPORT_DOW=7
